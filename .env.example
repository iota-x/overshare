# Copy this file to ".env" and fill it in.  cp .env.example .env

# --- Required: where she gets the updates ---
# Make a private Discord server/channel with her, then:
#   Channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# --- AI provider: how the one-liners get written ---
#   ollama    -> FREE, runs a small model locally on your Mac (default)
#   groq      -> FREE cloud (nothing runs on your Mac); free key at console.groq.com
#   anthropic -> Claude, best writing, costs money (needs a key)
AI_PROVIDER=ollama

# Groq (free cloud). GROQ_BASE_URL also works for Cerebras/OpenRouter/etc.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Ollama (free/local). Setup: brew install ollama && ollama pull llama3.2
OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# Anthropic (only if AI_PROVIDER=anthropic). Key: https://console.anthropic.com
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-4-8        # or claude-haiku-4-5 (much cheaper)

# Set AI_ENABLED=false for plain templated messages — no AI of any kind.
# AI_ENABLED=true

# Also report background music (Spotify / Apple Music). A song change = an update.
# REPORT_MEDIA=true

# Daily recap card (end of day)
# RECAP_ENABLED=true
# RECAP_TIME=23:00              # HH:MM local
# RECAP_MIN_MINUTES=5           # skip near-empty days

# Weekly "Wrapped" card
# WEEKLY_ENABLED=true
# WEEKLY_DAY=sun                # mon/tue/wed/thu/fri/sat/sun
# WEEKLY_TIME=20:00

# Sweet bookends: a gap this long before returning reads as "good morning".
# LONG_AWAY_SECONDS=14400       # 4 hours

# --- Two-way (optional): her replies + reactions reach your Mac ---
# Make a bot at https://discord.com/developers → Bot → Reset Token → paste here.
# Enable "Message Content Intent" on that page, and invite the bot to your server.
# DISCORD_BOT_TOKEN=
# BOT_PREFIX=!                   # bot command prefix (she can change it live: !prefix >)
# DISCORD_CHANNEL_ID=            # comma-separated channel IDs to listen in (blank = all)
# DISCORD_HOME_CHANNEL_ID=      # where quick-reply + good-morning post (default: first above)
# HER_NAME=                     # used in the good-morning line
# GM_ENABLED=true               # auto good-morning to the channel
# GM_TIME=08:30                 # HH:MM local

# --- Peek: let her see you on demand (!peek / !screen / !live) ---
# Needs `brew install imagesnap` for the webcam. macOS will ask for Camera and
# Screen Recording permission for the app the first time each is used.
# PEEK_ENABLED=true             # false = disable !peek / !screen / !live entirely
# PEEK_NOTIFY=true              # ping you on the Mac every time she peeks
# LIVE_SECONDS=20               # how long a !live burst runs
# LIVE_INTERVAL=2.5             # seconds between live-frame refreshes

# --- Optional ---
# WEBHOOK_USERNAME=in detail 💬
# WEBHOOK_AVATAR_URL=

# Timing (seconds)
# POLL_INTERVAL=4                 # how often it looks at what you're doing
# STABILIZE=12                    # new activity must persist this long before sending
# MIN_GAP=45                      # min seconds between change-updates
# HEARTBEAT=300                   # "still doing X" every 5 min
# IDLE_THRESHOLD=300              # "away" after 5 min of no input
# START_PAUSED=false

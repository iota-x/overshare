<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.iota.in-detail</string>

    <!-- Run the packaged .app bundle's executable directly: gives it a proper
         signed app identity (reliable Accessibility) AND launchd keep-alive. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/In Detail.app/Contents/MacOS/In Detail</string>
    </array>

    <!-- Start on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart it if it ever crashes -->
    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/ankit_pandey/Desktop/projects/in-detail/in-detail.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ankit_pandey/Desktop/projects/in-detail/in-detail.log</string>
</dict>
</plist>
